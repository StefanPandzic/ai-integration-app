{
  "name": "speech-to-text-backend",
  "version": "1.0.0",
  "description": "Coaching call intelligence backend: Grain → LLM summaries → Slack/Drive, weekly reports",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:migrate": "ts-node-dev --transpile-only src/db/migrate.ts",
    "llm:check": "ts-node-dev --transpile-only src/scripts/llmCheck.ts",
    "db:seed": "ts-node-dev --transpile-only src/db/seed.ts",
    "db:reset-calls": "ts-node-dev --transpile-only src/db/resetCalls.ts",
    "reports:check": "ts-node-dev --transpile-only src/scripts/reportsCheck.ts",
    "eval": "ts-node-dev --transpile-only src/scripts/eval.ts"
  },
  "keywords": [
    "ollama",
    "ai",
    "speech-to-text",
    "sse"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
