# Server Configuration
PORT=3001

# Ollama Configuration
OLLAMA_API_KEY=00000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Claude (primary LLM; model settings live in src/config/aiModels.ts)
ANTHROPIC_API_KEY=

# Postgres: postgresql://<user>:<password>@<host>:<port>/<database>
# Local: user "postgres" + the password chosen in the installer, port 5432
# Supabase: Connect → Session pooler URI (remove sslmode)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/coaching_calls
# Optional: path to Supabase CA cert to enable TLS verification
DATABASE_CA_CERT=

# Grain: mock (sample calls, default) or live (not implemented yet)
GRAIN_MODE=mock
# Shared secret for webhook signatures (optional in mock mode)
GRAIN_WEBHOOK_SECRET=

# Slack: mock (default) writes every message to the dashboard outbox;
# live posts with SLACK_BOT_TOKEN (see docs/INTEGRATIONS.md)
SLACK_MODE=mock
SLACK_BOT_TOKEN=
# Channel used by `npm run db:seed` for all demo clients
SLACK_DEMO_CHANNEL_ID=
# Weekly manager report and ops alerts (defaults "#coaching-managers" and
# "#coaching-ops"; quote values that start with #)
SLACK_MANAGER_CHANNEL_ID=
SLACK_OPS_CHANNEL_ID=

# Google Drive: mock only for now (documents go to the dashboard outbox)
DRIVE_MODE=mock

# Dashboard base URL for links in Slack messages and Drive docs (default CORS_ORIGIN)
DASHBOARD_URL=

# Weekly reports: cron in America/Chicago (default Monday 7:00)
REPORTS_CRON=0 7 * * 1
REPORTS_CRON_ENABLED=true
