# Server Configuration
PORT=3001

# Ollama Configuration
OLLAMA_API_KEY=00000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Claude (primary LLM; model settings live in src/config/aiModels.ts)
ANTHROPIC_API_KEY=

# Postgres: postgresql://<user>:<password>@<host>:<port>/<database>
# Local: user "postgres" + the password chosen in the installer, port 5432
# Supabase: Connect → Session pooler URI (remove sslmode)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/coaching_calls
# Optional: path to Supabase CA cert to enable TLS verification
DATABASE_CA_CERT=

# Grain: mock (sample calls, default) or live (not implemented yet)
GRAIN_MODE=mock
# Shared secret for webhook signatures (optional in mock mode)
GRAIN_WEBHOOK_SECRET=

# Slack: leave SLACK_BOT_TOKEN empty for dry-run (messages logged, not sent)
SLACK_BOT_TOKEN=
# Channel used by `npm run db:seed` for all demo clients
SLACK_DEMO_CHANNEL_ID=
